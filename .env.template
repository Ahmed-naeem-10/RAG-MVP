# =============================================================================
# RAG MVP — Environment Variables Template (Free Tier: Groq + Local Embeddings)
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- REQUIRED ---

# Your Groq API key (FREE). Get it from: https://console.groq.com
# Steps: Sign up → API Keys → Create API Key
# Format: gsk_...
GROQ_API_KEY=your-groq-api-key-here


# --- LLM MODEL (Groq - Free) ---

# Groq model for answer generation.
# Free options: llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# Default: llama-3.1-70b-versatile (best quality, still free)
LLM_MODEL=llama-3.1-70b-versatile


# --- EMBEDDING MODEL (Local - Completely Free, No API Key) ---

# HuggingFace sentence-transformers model (runs locally on your machine).
# Default: all-MiniLM-L6-v2 (fast, small, good quality)
# Alternative: all-mpnet-base-v2 (slower but better quality)
EMBEDDING_MODEL=all-MiniLM-L6-v2


# --- CHUNKING PARAMETERS ---

# Maximum number of characters per chunk.
# Accepted range: 500–4000 (integer)
# Default: 1000
CHUNK_SIZE=1000

# Number of overlapping characters between consecutive chunks.
# Accepted range: 50–500 (integer), must be < CHUNK_SIZE
# Default: 200
CHUNK_OVERLAP=200


# --- RETRIEVAL PARAMETERS ---

# Number of top chunks to retrieve for each query (top-K).
# Accepted range: 1–20 (integer)
# Default: 5
TOP_K=5

# Minimum cosine similarity score [0.0–1.0] for a chunk to be included.
# Default: 0.30
SIMILARITY_THRESHOLD=0.30


# --- STORAGE ---

# Path to ChromaDB persistence directory.
# Default: ./chroma_db
CHROMA_PERSIST_DIR=./chroma_db

# Path to your PDF documents directory.
# Default: ./data
DOCS_DIR=./data

# Path for BM25 hybrid search index (optional).
# Default: ./bm25_index.pkl
BM25_INDEX_PATH=./bm25_index.pkl


# --- HYBRID SEARCH (OPTIONAL) ---

# Enable hybrid search (dense vector + BM25 keyword search).
# Accepted values: true, false
# Default: false
ENABLE_HYBRID_SEARCH=false
